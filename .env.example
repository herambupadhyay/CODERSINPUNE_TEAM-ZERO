# ProjectPulse backend environment
# Copy to .env and fill in values. NEVER commit .env.

# --- Database ---
# Local PostgreSQL 17 (projectpulse database, dedicated role)
DATABASE_URL=postgresql+psycopg://projectpulse:projectpulse_dev_pw@127.0.0.1:5432/projectpulse
# Tests use: postgresql+psycopg://projectpulse:projectpulse_dev_pw@127.0.0.1:5432/projectpulse_test

# --- Auth ---
# Secret used to sign session tokens. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=pp_session
SESSION_TTL_HOURS=72

# --- CORS / origins (comma separated) ---
CORS_ORIGINS=http://localhost:5199,http://127.0.0.1:5199

# --- LLM provider (OpenAI-compatible; NVIDIA NIM configured) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_FALLBACK_MODEL=deepseek-ai/deepseek-v4.1-flash
LLM_TIMEOUT_SECONDS=90
EMBED_MODEL=nvidia/nemotron-3-embed-1b
EMBED_DIM=2048

# When true (or when LLM_API_KEY is empty) extraction runs in
# clearly-labelled sample mode instead of calling a real provider.
DEMO_MODE=false

# --- Uploads ---
MAX_UPLOAD_MB=20
STORAGE_DIR=storage

# --- Server ---
API_HOST=127.0.0.1
API_PORT=8000
